# Copy to .env and fill in. Never commit .env.

# Claude (Anthropic) — used from Dev-4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web search (Tavily, free key at tavily.com) — used from Dev-3
TAVILY_API_KEY=
# tavily = real search; fake = canned results, no network
SEARCH_PROVIDER=tavily

# /debug/* endpoints (local development only; set false when deployed)
DEBUG_ENDPOINTS=true
